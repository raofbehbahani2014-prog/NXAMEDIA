<%
  const _d = demoFile || '';
  const _ext = _d.split('.').pop().toLowerCase();
  const _isVideo = ['mp4', 'webm', 'mov'].includes(_ext);
  const _isAudio = ['mp3', 'wav', 'ogg', 'm4a', 'aac'].includes(_ext);
  const _isImg = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'].includes(_ext);
%>
<div class="buy-box">
  <% if (_d) { %>
    <div class="demo-block">
      <h4>🎁 نمونه رایگان</h4>
      <% if (_isVideo) { %><video src="<%= _d %>" controls preload="metadata"></video><% } %>
      <% if (_isAudio) { %><audio src="<%= _d %>" controls></audio><% } %>
      <% if (_isImg) { %><img loading="lazy" src="<%= _d %>" alt="نمونه رایگان"><% } %>
      <a href="<%= _d %>" download class="btn btn-outline" style="width:100%; text-align:center;">⬇️ دانلود نمونه رایگان</a>
    </div>
  <% } %>

  <% if (typeof missingFile !== 'undefined' && missingFile) { %>
    <p class="alert-err" style="margin-bottom:12px;">⚠️ (فقط برای ادمین) فایل کامل این محصول هنوز آپلود نشده است. مشتری بعد از پرداخت چیزی برای دانلود نخواهد داشت.</p>
  <% } %>
  <div class="buy-main">
    <% if (access) { %>
      <p class="buy-status ok">✅ شما این محصول را خریداری کرده‌اید.</p>
      <a href="/download/<%= type %>/<%= id %>" class="btn btn-primary" style="width:100%; text-align:center;">⬇️ دانلود نسخه کامل</a>
    <% } else if (sellable) { %>
      <div class="buy-price"><%= fmtMoney(amount) %> <small>تومان</small></div>
      <a href="/checkout/<%= type %>/<%= id %>" class="btn btn-primary" style="width:100%; text-align:center;">🛒 خرید و دانلود نسخه کامل</a>
      <p class="buy-hint">پرداخت آنلاین یا کارت‌به‌کارت — بعد از پرداخت، دانلود از پنل شما فعال می‌شود.</p>
    <% } else { %>
      <p class="buy-status">نسخه کامل به‌زودی برای خرید فعال می‌شود.</p>
    <% } %>
  </div>
</div>
