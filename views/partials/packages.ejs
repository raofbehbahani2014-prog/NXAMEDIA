<div class="grid grid-3">
  <% pricing.forEach(p => { %>
    <div class="price-card <%= p.highlight === 'yes' || p.highlight === true ? 'highlight' : '' %>">
      <h3><%= p.name %></h3>
      <div class="price"><%= p.price %></div>
      <ul>
        <% (p.features || []).forEach(f => { %><li>✔️ <%= f %></li><% }) %>
      </ul>
      <a href="/order/package/<%= p.id %>" class="btn <%= (p.highlight === 'yes' || p.highlight === true) ? 'btn-primary' : 'btn-outline' %>" style="width:100%; text-align:center;"><%= amountOf(p) ? 'سفارش این پکیج' : 'درخواست مشاوره و قیمت' %></a>
    </div>
  <% }) %>
</div>
