<%- include('../partials/header') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="breadcrumb"><a href="/">خانه</a> / تماس با ما</div>
    <h1>تماس با <span class="highlight">NxMedia</span></h1>
    <p>سوالی دارید یا می‌خواهید همکاری را شروع کنید؟ فرم زیر را پر کنید یا از راه‌های ارتباطی زیر استفاده کنید.</p>
  </div>
</section>

<section>
  <div class="container grid grid-2">
    <div class="form-box" style="margin:0;">
      <h3 style="margin-bottom:16px;">ارسال پیام</h3>
      <form action="/contact" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>نام</label>
            <input type="text" name="name" required>
          </div>
          <div class="form-group">
            <label>شماره تماس</label>
            <input type="text" name="phone" required>
          </div>
        </div>
        <div class="form-group">
          <label>ایمیل</label>
          <input type="email" name="email">
        </div>
        <div class="form-group">
          <label>پیام شما</label>
          <textarea name="message" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ارسال پیام</button>
      </form>
    </div>
    <div>
      <div class="card" style="margin-bottom:20px;">
        <h3>📞 راه‌های ارتباطی</h3>
        <p>تلفن: <%= site.contact.phone %><br>واتساپ: <%= site.contact.whatsapp %><br>ایمیل: <%= site.contact.email %></p>
      </div>
      <div class="card">
        <h3>💬 اتصال مستقیم</h3>
        <p style="margin-bottom:14px;">برای پاسخ سریع‌تر می‌توانید مستقیم از طریق پیام‌رسان‌ها با ما در تماس باشید.</p>
        <div style="display:flex; gap:10px;">
          <a href="#" class="btn btn-outline">اینستاگرام</a>
          <a href="#" class="btn btn-outline">واتساپ</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background:#fff;">
  <div class="container">
    <div class="section-head">
      <div class="tag">سوالات متداول</div>
      <h2>پاسخ به پرتکرارترین سوالات</h2>
    </div>
    <% faqs.slice(0,3).forEach(f => { %>
      <div class="faq-item">
        <h3><%= f.q %></h3>
        <p><%= f.a %></p>
      </div>
    <% }) %>
    <div style="text-align:center; margin-top:16px;">
      <a href="/faq" class="btn btn-outline">مشاهده همه سوالات</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
