<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-box">
      <h1>ورود به پنل ادمین</h1>
      <p class="sub">Nx<b>Media</b> Admin Panel</p>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>
      <form action="/admin/login" method="POST">
        <div class="form-group">
          <label>نام کاربری</label>
          <input type="text" name="username" required autofocus>
        </div>
        <div class="form-group">
          <label>رمز عبور</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ورود</button>
      </form>
      <p class="hint" style="text-align:center; margin-top:16px;">پیش‌فرض: admin / admin123 (قابل تغییر در فایل .env)</p>
    </div>
  </div>
</body>
</html>
