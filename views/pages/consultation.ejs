<%- include('../partials/header') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="breadcrumb"><a href="/">خانه</a> / رزرو مشاوره</div>
    <h1>رزرو <span class="highlight">مشاوره رایگان</span> اینستاگرام</h1>
    <p>یک جلسه ۳۰ دقیقه‌ای رایگان با کارشناسان ما برای بررسی وضعیت پیج و ارائه راهکار رشد.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="form-box">
      <form action="/consultation" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>نام و نام خانوادگی</label>
            <input type="text" name="name" required>
          </div>
          <div class="form-group">
            <label>شماره تماس</label>
            <input type="text" name="phone" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>تاریخ پیشنهادی</label>
            <input type="date" name="date" required>
          </div>
          <div class="form-group">
            <label>ساعت پیشنهادی</label>
            <input type="time" name="time" required>
          </div>
        </div>
        <div class="form-group">
          <label>موضوع مشاوره</label>
          <textarea name="topic" placeholder="مثلا: بررسی استراتژی محتوا، افزایش فروش از اینستاگرام..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ثبت درخواست رزرو</button>
      </form>
      <p style="font-size:12px; color:var(--gray); text-align:center; margin-top:14px;">
        زمان نهایی جلسه پس از هماهنگی از طریق واتساپ یا تماس تلفنی به شما اطلاع داده می‌شود.
      </p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
