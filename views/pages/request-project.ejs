<%- include('../partials/header') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="breadcrumb"><a href="/">خانه</a> / درخواست پروژه</div>
    <h1>ثبت <span class="highlight">درخواست پروژه</span></h1>
    <p>فرم زیر را تکمیل کنید تا کارشناسان ما در سریع‌ترین زمان با شما تماس بگیرند.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="form-box">
      <form action="/request-project" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>نام و نام خانوادگی</label>
            <input type="text" name="name" required>
          </div>
          <div class="form-group">
            <label>نام کسب‌وکار / برند</label>
            <input type="text" name="brand">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>شماره تماس / واتساپ</label>
            <input type="text" name="phone" required>
          </div>
          <div class="form-group">
            <label>آیدی اینستاگرام</label>
            <input type="text" name="instagram" placeholder="@username">
          </div>
        </div>
        <div class="form-group">
          <label>خدمت مورد نظر</label>
          <select name="service">
            <% services.forEach(s => { %>
              <option value="<%= s.title %>"><%= s.title %></option>
            <% }) %>
            <option value="سایر">سایر / مشخص نیست</option>
          </select>
        </div>
        <div class="form-group">
          <label>بودجه تقریبی ماهانه (اختیاری)</label>
          <input type="text" name="budget" placeholder="مثلا ۱۰ تا ۱۵ میلیون تومان">
        </div>
        <div class="form-group">
          <label>توضیحات پروژه</label>
          <textarea name="message" placeholder="در مورد کسب‌وکار و نیاز خود توضیح دهید..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ثبت درخواست</button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
