<%- include('../partials/header') %>

<section class="hero" style="padding:60px 0;">
  <div class="container">
    <div class="breadcrumb"><a href="/">خانه</a> / دوره‌های آموزشی</div>
    <h1>دوره‌های <span class="highlight">آموزشی</span> NxMedia</h1>
    <p>یادگیری اصولی تولید محتوا، سناریونویسی و مدیریت پیج از تیم متخصص ما.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="grid grid-3">
      <% courses.forEach(c => { %>
        <div class="card">
          <h3><%= c.title %></h3>
          <p><%= c.summary %></p>
          <p style="font-size:13px;">🕒 <%= c.duration %> &nbsp; | &nbsp; 🎯 <%= c.level %></p>
          <p style="font-weight:700; color:var(--primary-dark);"><%= c.price %></p>
          <a class="more" href="/courses/<%= c.slug %>">مشاهده جزئیات دوره ←</a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
