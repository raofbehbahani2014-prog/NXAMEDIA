<%- include('../../partials/header') %>

<section style="padding:40px 0;">
  <div class="container">
    <h1 style="font-size:24px;">خوش آمدید، <%= currentUser.name %> 👋</h1>
    <div class="panel-layout" style="margin-top:24px;">
      <%- include('../../partials/client-sidebar', { active: 'dashboard' }) %>
      <div class="panel-content">
        <div class="grid grid-3" style="margin-bottom:30px;">
          <div class="stat-box"><strong><%= fmtMoney(stats.activeProjects) %></strong><span>پروژه فعال</span></div>
          <div class="stat-box"><strong><%= fmtMoney(stats.pendingContent) %></strong><span>محتوای در انتظار تایید</span></div>
          <div class="stat-box"><strong><%= fmtMoney(stats.unpaidInvoices) %></strong><span>فاکتور در انتظار پرداخت</span></div>
        </div>
        <h3 style="margin-bottom:14px;">آخرین فعالیت‌ها</h3>
        <% if (!notices.length) { %>
          <div class="faq-item">
            <h3>هنوز فعالیتی ثبت نشده است</h3>
            <p>پس از هماهنگی با تیم <%= site.siteName %>، پروژه‌ها، تقویم محتوایی و فاکتورهای شما اینجا نمایش داده می‌شود.</p>
          </div>
        <% } %>
        <% notices.forEach(n => { %>
          <div class="faq-item">
            <h3><%= n.title %></h3>
            <% if (n.text) { %><p><%= n.text %></p><% } %>
            <p style="font-size:12px; margin-top:6px;"><%= fmtDate(n.createdAt) %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
