<%- include('../../partials/header') %>

<section class="hero" style="padding:80px 0; text-align:center;">
  <div class="container">
    <h1>ورود به <span class="highlight">پنل مشتری</span></h1>
    <p style="margin:0 auto;">برای مشاهده وضعیت پروژه، تقویم محتوایی و فاکتورها وارد شوید.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="form-box">
      <% if (error) { %>
        <p style="color:#DC2626; background:#FEE2E2; padding:10px 14px; border-radius:10px; font-size:14px;"><%= error %></p>
      <% } %>
      <form action="/client/login" method="POST">
        <div class="form-group">
          <label>ایمیل</label>
          <input type="email" name="email" required autocomplete="email">
        </div>
        <div class="form-group">
          <label>رمز عبور</label>
          <input type="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">ورود</button>
      </form>
      <p style="font-size:14px; text-align:center; margin-top:16px;">
        حساب ندارید؟ <a href="/client/register" style="color:var(--primary); font-weight:700;">ثبت‌نام کنید</a>
      </p>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
