<%- include('../partials/header') %>

<section class="hero" style="padding:90px 0; text-align:center;">
  <div class="container">
    <div style="font-size:60px;"><%= ok ? '✅' : '⚠️' %></div>
    <h1><%= ok ? 'پرداخت با موفقیت انجام شد' : 'پرداخت کامل نشد' %></h1>
    <% if (ok && order && order.refId) { %><p style="margin:0 auto 20px;">شماره پیگیری: <b dir="ltr"><%= order.refId %></b></p><% } %>
    <% if (!ok && msg) { %><p style="margin:0 auto 20px;"><%= msg %></p><% } %>
    <div class="hero-actions">
      <a href="/client/purchases" class="btn btn-primary">خریدهای من</a>
      <a href="/" class="btn btn-outline">صفحه اصلی</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
